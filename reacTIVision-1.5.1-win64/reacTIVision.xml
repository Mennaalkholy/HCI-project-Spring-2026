<?xml version="1.0" encoding="ISO-8859-1" ?>
<reactivision>
    <!--
		
	these are all the possible configuration tags and their default values.

	you only need to specify parameters you want to change from their default setting.
	please note that active tags need to be placed outside of this commented area!

	<tuio host="127.0.0.1" port="3333" />
	<midi config="midi.xml" />
	<camera config="camera.xml" />
	<finger size="12" sensitivity="100" />
	<fiducial engine="amoeba" tree="symbols/amoeba/small.trees" />
	<image display="dest" equalize="false" fullscreen="false" />
	<threshold gradient="32" tile="10" threads="max" />
	<calibration grid="calibration.grid" invert="xya" />
    -->
    <!-- TUIO to TuioDemo (same port as backend/Python tuio_only_service default) -->
    <tuio host="127.0.0.1" port="3333" />
    <!-- Tree file lives under symbols/amoeba/ (plain "small.trees" fails to open from exe folder). -->
    <fiducial engine="amoeba" tree="symbols/amoeba/default.trees" />
    <finger size="0" sensitivity="75" />
    <image display="dest" equalize="true" fullscreen="false" />
    <threshold gradient="20" tile="8" threads="max" />
    <!-- 1.5.1 reads the grid path from attribute "grid", not "file" (comment still shows legacy "file"). -->
    <calibration grid="none" invert=" " />
</reactivision>
