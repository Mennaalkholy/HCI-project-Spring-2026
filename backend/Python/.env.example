# Copy to .env and adjust (or set in shell before launch).

# --- Split cameras (DirectShow) ---
# Index 4: OBS Virtual Camera → main.py + face_auth (MediaPipe / YOLO / face)
MAIN_CAPTURE_INDEX=4
FACE_CAPTURE_INDEX=4
# Index 2: SplitCam → tuio_only_service (reacTIVision: camera.xml <camera id="2">)
TUIO_CAPTURE_INDEX=2
CAMERA_CAPTURE_BACKEND=dshow
# Optional per-service fallbacks (comma-separated):
# CAMERA_FALLBACK_INDICES=4,0,1,2,3
# Black / glitchy preview on Windows: try MSMF instead of DirectShow
# CAMERA_CAPTURE_BACKEND=msmf
# Optional: force resolution after open (some drivers need this)
# CAMERA_FRAME_WIDTH=640
# CAMERA_FRAME_HEIGHT=480
# If the image is very dark but real, lower these thresholds (defaults 10 and 3)
# CAMERA_MIN_MEAN_GRAY=6
# CAMERA_MIN_STD_GRAY=2
# Emergency: skip brightness check (not recommended)
# CAMERA_SKIP_FRAME_CHECK=1
# MAIN_WAIT_FOR_CAMERA=0
# MAIN_ALLOW_NO_CAMERA=1
# One physical webcam on Windows: do not let main.py grab the device (face_auth needs it)
# MAIN_SKIP_CAMERA=1
# MAIN_SYNTHETIC_FPS=15
PIPELINE_SERVICE_HOST=127.0.0.1
GAZE_PORT=5111
FACE_PORT=5112
OBJECT_PORT=5113
MEDIAPIPE_PORT=5114
BLUETOOTH_PORT=5115

# (TUIO_CAPTURE_INDEX=2 — see split cameras above)
# TUIO_WAIT_FOR_CAMERA=0
# TUIO_ALLOW_NO_CAMERA=1
# TUIO_SKIP_CAMERA=1
TUIO_HOST=127.0.0.1
TUIO_PORT=3333
TUIO_PLANE_SOURCE=merge
TUIO_HUB_ENABLE=1

# --- Notification hub (C# Json + Python peer fan-out) ---
HUB_HOST=127.0.0.1
HUB_PORT=5000
HUB_PLANE_RELAY=1

# --- YOLO (COCO default includes "airplane"; add custom names comma-separated) ---
YOLO_MODEL_PATH=yolo11n.pt
OBJECT_TARGET_CLASSES=airplane
OBJECT_CONF_THRESHOLD=0.35

# --- Plane calibration (Camo normalized bbox → table TUIO space) ---
PLANE_MAP_SCALE_X=1
PLANE_MAP_SCALE_Y=1
PLANE_MAP_OFFSET_X=0
PLANE_MAP_OFFSET_Y=0

# --- face_auth_service.py (face-only login; Camo index) ---
# (FACE_CAPTURE_INDEX=4 — see split cameras above)
# CAMERA_FALLBACK_INDICES=0,1,2,3
# FACE_NEW_USER_TIMEOUT_SEC=20
# FACE_KNOWN_MATCH_FRAMES=4
# FACE_PROVISION_STABLE_FRAMES=5
# FACE_HAAR_SCALE_FACTOR=1.1
# FACE_HAAR_MIN_NEIGHBORS=3
# FACE_HAAR_MIN_WIDTH=30
# FACE_HAAR_MIN_HEIGHT=30
# FACE_HAAR_EQUALIZE=1
